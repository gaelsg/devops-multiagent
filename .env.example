# Los secretos reales (Telegram, shared secret del webhook) viven en Vault
# (secret/devops-multiagent), no aqui. Este .env solo tiene el AppRole que
# sabe donde/como pedirlos - ver https://github.com/gaelsg/vault-secrets
VAULT_ADDR=https://192.168.8.91:8200
VAULT_CACERT=/home/gaelsg/projects/vault-secrets/tls/ca-cert.pem
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Fallback: si no defines lo de arriba, el proceso arranca con estas
# variables tal cual (ej. desarrollo local sin Vault). Con Vault configurado,
# estas se ignoran - los valores reales llegan de ahi en tiempo de ejecucion.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_SHARED_SECRET=

# Config, no secretos - se quedan en .env siempre.
WATCHER_NODE=batman01
WATCHER_STATE_PATH=~/projects/devops-multiagent/state/last_known.json

# Tracing (opcional, ver observability/docker-compose.yml -- Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.8.90:4317
